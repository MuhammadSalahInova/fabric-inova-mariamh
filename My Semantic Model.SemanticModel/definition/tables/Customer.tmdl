	/// The customer's postal code.
	column PostalCode
		dataType: string
		sourceProviderType: varchar(50)
		lineageTag: c9b5a8eb-9825-449d-8869-8a1f104693eb
		sourceLineageTag: PostalCode
		summarizeBy: none
		sourceColumn: PostalCode

		changedProperty = Description

		annotation SummarizationSetBy = Automatic

	/// The customer's country. Use it for geographic grouping, country rankings, and map analysis. Country values should be standardized for reliable map recognition.
	column Country
		dataType: string
		sourceProviderType: varchar(100)
		lineageTag: 48fccaa7-22ac-4b51-b5a8-291736117452
		sourceLineageTag: Country
		summarizeBy: none
		sourceColumn: Country

		changedProperty = Description

