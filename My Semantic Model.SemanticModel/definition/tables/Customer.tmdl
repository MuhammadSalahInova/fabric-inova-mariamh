/// Customer contains descriptive information about customers.
/// 
/// A customer can place many orders and can appear in many order-detail lines. Customer is connected to both Orders and Order_Details through CustomerKey.
/// 
/// Use this table for customer analysis, including customer sales, order frequency, customer geography, customer ranking, country analysis, and customer drillthrough.
/// 
/// Customer-level revenue is calculated from Order_Details. Customer-level order counts are calculated from Orders.
table Customer
	lineageTag: da75ea3a-ce55-4f84-9ff0-72f3ac36a95d
	sourceLineageTag: [dbo].[Dim_Customer]

	/// Total number of customers in the Customer dimension. This represents the customer master population and is not limited to customers who placed an order.
	measure 'Total Customers' =
			
			DISTINCTCOUNT(
			    'Customer'[CustomerID]
			)
		formatString: 0
		lineageTag: 2bb7463e-7337-47ba-a09c-57243a0c39b8

		changedProperty = Name

		changedProperty = Description

	/// Customers With Orders is the number of distinct customers who placed at least one order in the current filter context. It is different from the total number of customers in Customer.
	measure 'Customers With Orders' =
			
			DISTINCTCOUNT(
			    'Orders'[CustomerKey]
			)
		formatString: 0
		lineageTag: 13eeb2ae-6c1e-4182-b2ec-9973563b8a90

		changedProperty = Name

		changedProperty = Description

	/// Average Orders per Customer is the average number of orders placed by each customer who placed at least one order. It is calculated as Total Orders divided by Customers With Orders.
	measure 'Average Orders per Customer' =
			
			DIVIDE(
			    [Total Orders],
			    [Customers With Orders],
			    0
			)
		formatString: 0.00
		lineageTag: 2d9715e1-5929-4761-914e-7e33033f000e

		changedProperty = Name

		changedProperty = FormatString

		changedProperty = Description

	/// Sales per Customer is the average revenue generated per customer who placed at least one order. It is calculated as Total Sales divided by Customers With Orders.
	measure 'Sales per Customer' =
			
			DIVIDE(
			    [Total Sales],
			    [Customers With Orders],
			    0
			)
		formatString: "£"#,0.###############;-"£"#,0.###############;"£"#,0.###############
		lineageTag: 66b848df-a2fe-4c88-9cfd-c62931bb6376

		changedProperty = Name

		changedProperty = Description

		annotation PBI_FormatHint = {"currencyCulture":"en-GB"}

	measure 'Selected Customer Title' =
			
			"Customer Details - "
			    & COALESCE(
			        SELECTEDVALUE(Customer[CompanyName]),
			        "No Customer Selected"
			    )
		lineageTag: 719d0969-ffc7-4e49-b0ef-ba2c309e43ea

		changedProperty = Name

	/// The surrogate key identifying the customer in the dimensional model. It connects Customer to Orders and Order_Details.
	column CustomerKey
		dataType: int64
		formatString: 0
		sourceProviderType: bigint
		lineageTag: a139f848-b5eb-45af-a13d-1c4c1181f329
		sourceLineageTag: CustomerKey
		summarizeBy: none
		sourceColumn: CustomerKey

		changedProperty = Description

		annotation SummarizationSetBy = Automatic

	/// The original business identifier of the customer from the source system.
	column CustomerID
		dataType: string
		sourceProviderType: varchar(50)
		lineageTag: 908a8ea6-f032-4cc4-b895-60b8ea821d9d
		sourceLineageTag: CustomerID
		summarizeBy: none
		sourceColumn: CustomerID

		changedProperty = Description

		annotation SummarizationSetBy = Automatic

	/// The customer company or business name. Use it as the main customer label in reports and customer rankings.
	column CompanyName
		dataType: string
		sourceProviderType: varchar(255)
		lineageTag: 0ecbe77e-4aa8-467a-b618-2a2738b61c82
		sourceLineageTag: CompanyName
		summarizeBy: none
