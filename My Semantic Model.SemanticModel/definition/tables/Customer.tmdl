	/// Indicates whether this is the current version of the customer dimension record.
	column IsCurrent
		dataType: boolean
		formatString: """TRUE"";""TRUE"";""FALSE"""
		sourceProviderType: bit
		lineageTag: d58c1065-2f25-45b3-856b-6b27e6c2c7ac
