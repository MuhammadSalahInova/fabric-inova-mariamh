	/// The customer's address.
	column Address
		dataType: string
		sourceProviderType: varchar(500)
		lineageTag: abe30dbc-5419-46bd-853e-5d0e6f4b9701
		sourceLineageTag: Address
		summarizeBy: none
		sourceColumn: Address

		changedProperty = Description

		annotation SummarizationSetBy = Automatic

	/// The customer's city.
	column City
		dataType: string
		sourceProviderType: varchar(100)
		lineageTag: 157b706d-74ec-4359-9cf0-599692025c76
		sourceLineageTag: City
		summarizeBy: none
		sourceColumn: City

		changedProperty = Description

