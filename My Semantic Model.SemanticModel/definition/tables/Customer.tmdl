	column Region
		dataType: string
		sourceProviderType: varchar(100)
		lineageTag: b0bb673b-7e9a-4ad3-9dca-ab2b26d5cfa1
		sourceLineageTag: Region
		summarizeBy: none
		sourceColumn: Region

