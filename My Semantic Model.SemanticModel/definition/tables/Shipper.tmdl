/// Shipper contains descriptive information about shipping companies or carriers.
/// 
/// A shipper can be associated with many customer orders. Shipper filters Orders through ShipperKey.
/// 
/// Use this table for shipping workload, orders by shipper, freight analysis, average freight per order, and shipment performance.
table Shipper
	lineageTag: e0c5da25-faac-4a68-a40c-0ce101c17472
	sourceLineageTag: [dbo].[Dim_Shipper]

	/// Surrogate key that uniquely identifies a shipper in the dimensional model. It connects Shipper to Orders and is primarily used for relationships.
	column ShipperKey
		dataType: int64
		formatString: 0
		sourceProviderType: bigint
		lineageTag: 0b8e9cca-a235-4f8e-b00e-de00918a8dd6
		sourceLineageTag: ShipperKey
		summarizeBy: none
		sourceColumn: ShipperKey

		changedProperty = Description

		annotation SummarizationSetBy = Automatic

	/// Original business identifier of the shipper from the source system.
	column ShipperID
		dataType: int64
		formatString: 0
		sourceProviderType: int
		lineageTag: f76dfb88-39dc-44c2-aebb-697f2f6f93ad
		sourceLineageTag: ShipperID
		summarizeBy: none
		sourceColumn: ShipperID

		changedProperty = Description

